# Java sources are stored and checked out LF, so an edit never renormalises
# a file's other lines into the diff.
*.java text eol=lf

# PowerShell must stay CRLF: the CI runners are Windows PowerShell 5.1.
*.ps1 text eol=crlf
# cmd.exe resolves call/goto labels by scanning lines, which misfires on LF-only
# scripts, so batch entry points such as Packman's packman.cmd check out CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# The release zips carry these texts byte for byte, so every checkout, on any
# platform or autocrlf setting, builds the same zip.
packaging/content/**/*.txt text eol=lf
