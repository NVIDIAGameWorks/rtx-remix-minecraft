{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "version": "${version}",
    "name": "RTX Remix for Minecraft",
    "description": "Renders Minecraft through NVIDIA RTX Remix path tracing. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "NVIDIA"
    ],
    "contact": {
        "homepage": "https://github.com/NVIDIAGameWorks/rtx-remix-minecraft",
        "sources": "https://github.com/NVIDIAGameWorks/rtx-remix-minecraft",
        "issues": "https://github.com/NVIDIAGameWorks/rtx-remix-minecraft/issues"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.nvidia.rtxremix.fabric.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.fabric.RtxRemixMod"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json",
        "rtx-remix-renderer.vanilla-section.mixins.json",
        "rtx-remix-renderer.fabric.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": "${loaderVersionRange}",
        "fabric-api": "${apiVersionRange}",
        "minecraft": "${minecraftVersion}",
        "java": ">=21"
    }
}
